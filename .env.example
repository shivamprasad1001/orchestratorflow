# Copy this file to .env and fill in the values for your local machine.

# LLM routing
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# Google Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI fallback/alternative
OPENAI_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orchestratorflow
